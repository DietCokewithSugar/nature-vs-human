{
  "name": "human-bill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "人类账单支付：自然界联合起来，向人类城市催收生态欠款的放置增量游戏。",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node --experimental-strip-types --no-warnings scripts/simulate.ts",
    "report": "node --experimental-strip-types --no-warnings scripts/report.ts",
    "sprites": "python3 art/build.py",
    "font": "node scripts/subset-font.mjs",
    "frames": "node scripts/ui-frames.mjs"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "@supabase/supabase-js": "2.118.0",
    "break_infinity.js": "2.2.0",
    "pixi.js": "8.22.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@fontsource/fusion-pixel-12px-proportional-sc": "5.3.0",
    "@preact/preset-vite": "2.10.6",
    "@radix-ui/colors": "3.0.0",
    "@types/node": "22.19.1",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
