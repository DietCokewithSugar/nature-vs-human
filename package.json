{
  "name": "human-bill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "人类账单支付：自然界联合起来，向人类城市催收生态欠款的放置增量游戏。",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node --experimental-strip-types --no-warnings scripts/simulate.ts",
    "assets": "node scripts/fetch-assets.mjs",
    "report": "node --experimental-strip-types --no-warnings scripts/report.ts",
    "models": "node scripts/build-models.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "5.2.10",
    "@fontsource/zcool-kuaile": "5.2.8",
    "@preact/signals": "2.11.3",
    "@radix-ui/colors": "3.0.0",
    "@supabase/supabase-js": "2.118.0",
    "break_infinity.js": "2.2.0",
    "preact": "10.29.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@gltf-transform/cli": "4.4.2",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.19.1",
    "@types/three": "0.186.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
